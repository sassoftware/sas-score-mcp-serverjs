{
  "name": "@sassoftware/sas-score-mcp-serverjs",
  "version": "2.0.0",
  "description": "A mcp server for SAS Viya",
  "author": "Deva Kumar <deva.kumar@sas.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.9.2"
  },
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 node  cli.js",
    "testi": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 npx @modelcontextprotocol/inspector",
    "test": "cd test && node",
    "debug": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0  node --inspect-brk cli.js",
    "getViyatls": "bash ./scripts/getViyaca.sh",
    "push2acr": "bash ./push2acr.sh",
    "push2ghcr": "bash ./push2ghcr.sh",
    "bump": "npm version prerelease",
    "pub": "npm publish --tag dev --access public",
    "test:github": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 node cli.js --mcptype http -c vscodemcpclient -a oauthclient"
  },
  "repository": "https://github.com/sassoftware/sas-score-mcp-serverjs",
  "bugs": {
    "url": "https://github.com/sassoftware/sas-score-mcp-serverjs/issues"
  },
  "keywords": [
    "SAS Viya",
    "mcp-serverjs",
    "SAS Viya scoring",
    "Viya actions",
    "restaf",
    "restafedit",
    "restaflib",
    "model context protocol",
    "skills",
    "agent",
    "Agentic AI"
  ],
  "main": "./cli.js",
  "bin": {
    "@sassoftware/sas-score-mcp-serverjs": "./cli.js"
  },
  "files": [
    "src",
    "cli.js",
    "openApi.json",
    "openApi.yaml",
    "scripts",
    ".github"
  ],
  "dependencies": {
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@sassoftware/restaf": "^5.7.2",
    "@sassoftware/restafedit": "^3.10.5",
    "@sassoftware/restaflib": "^5.7.2",
    "axios": "^1.13.5",
    "cross-env": "^10.1.0",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "pdfkit": "^0.20.2",
    "selfsigned": "^5.2.0",
    "undici": "^7.24.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@types/debug": "^4.1.12",
    "@types/node": "^25.0.3",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  }
}
